# All optional — the server runs with sensible defaults if this file doesn't exist.

# NEURODB_DATA_ROOT=./neurodb_data
# NEURODB_HOST=localhost:8000
# NEURODB_CORS_ORIGINS=*
# NEURODB_SECRET_KEY=change-me-in-production

# Opt-in image/audio captioning (nlp/captioning.py) — off unless set.
# google-genai is a core dependency, always installed.
# NEURODB_CAPTION_API_KEY=
# NEURODB_CAPTION_MODEL=gemini-flash-lite-latest

# Opt-in local Whisper transcription (nlp/transcription.py) — required for
# MP3 ingestion specifically (.wav never needs this). faster-whisper/av are
# core dependencies, always installed.
# NEURODB_TRANSCRIBE_BACKEND=whisper
# NEURODB_WHISPER_MODEL=tiny
