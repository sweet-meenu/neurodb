# Leave blank if you're pasting this live into the Streamlit sidebar during a demo instead.
NEURODB_CONNECTION_STRING=neurodb://<project_id>:<api_key>@localhost:8000

GENERATOR_BACKEND=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Only used if GENERATOR_BACKEND=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Only used if GENERATOR_BACKEND=ollama (a free, local alternative — no API key)
OLLAMA_MODEL=llama3
